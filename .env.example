# Microsoft Graph credentials (from your boss / Azure Portal)
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Groq API key (from console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Public URL of this server, needed later for webhooks (not needed for manual testing)
PUBLIC_BASE_URL=https://your-deployed-url.com

# A random secret string YOU make up — used to verify webhook notifications are really from Microsoft
WEBHOOK_CLIENT_STATE=change-this-to-a-random-string
